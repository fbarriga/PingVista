{
  "expo": {
    "name": "PingVista",
    "slug": "pingvista",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 29,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      "./plugins/withReleaseSigning.js",
      "./plugins/withR8Optimizations.js",
      "@react-native-firebase/app",
      "@react-native-firebase/analytics"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "cl.felipebarriga.pingvista",
      "buildNumber": "3",
      "googleServicesFile": "./GoogleService-Info.plist",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "PingVista uses the local network to measure latency to your router and to other hosts you choose."
      }
    },
    "android": {
      "package": "cl.felipebarriga.pingvista",
      "versionCode": 3,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.WAKE_LOCK",
        "android.permission.CHANGE_WIFI_STATE"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.VIBRATE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    }
  }
}
